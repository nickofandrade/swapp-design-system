{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "orange": {
      "$type": "color",
      "$value": "#FF7B0D",
      "$description": "Ação e fundo principal em botões e gradientes"
    },
    "orange-light": {
      "$type": "color",
      "$value": "#FFA84C",
      "$description": "Ponta clara do gradiente e hover do botão laranja"
    },
    "orange-top": {
      "$type": "color",
      "$value": "#FF7F13",
      "$description": "Barra superior dos layouts mobile"
    },
    "orange-border": {
      "$type": "color",
      "$value": "#FFA200",
      "$description": "Borda dos campos de texto"
    },
    "magenta": {
      "$type": "color",
      "$value": "#C40BD5",
      "$description": "Botão principal e fundo do fluxo 404"
    },
    "magenta-hover": {
      "$type": "color",
      "$value": "#EA00FF",
      "$description": "Hover do botão magenta e gradiente 404"
    },
    "facebook": {
      "$type": "color",
      "$value": "#3A589A",
      "$description": "Botão de cadastro social"
    },
    "facebook-hover": {
      "$type": "color",
      "$value": "#4E6DB2",
      "$description": "Hover do botão social"
    },
    "coral": {
      "$type": "color",
      "$value": "#E19C8A",
      "$description": "Texto de campo e teclas circulares"
    },
    "placeholder": {
      "$type": "color",
      "$value": "#E1E1E1",
      "$description": "Texto de placeholder"
    },
    "orange-profile": {
      "$type": "color",
      "$value": "#FFA446",
      "$description": "Fundo de linhas de perfil"
    },
    "orange-hero": {
      "$type": "color",
      "$value": "#FF8820",
      "$description": "Sobreposição da hero da landing page"
    },
    "white": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Texto e superfícies de componentes"
    },
    "disabled-gray": {
      "$type": "color",
      "$value": "#CCCCCC",
      "$description": "Fundo do switch desativado"
    }
  },
  "font": {
    "family": {
      "ui": {
        "$type": "fontFamily",
        "$value": "\"Averia Sans Libre\", cursive",
        "$description": "Família tipográfica identificada nos CSS originais."
      }
    },
    "size": {
      "button": {
        "$type": "dimension",
        "$value": "15px",
        "$description": "Tamanho da fonte dos botões originais."
      },
      "body": {
        "$type": "dimension",
        "$value": "14px",
        "$description": "Tamanho base do body na maior parte das telas mobile."
      },
      "input": {
        "$type": "dimension",
        "$value": "15px",
        "$description": "Tamanho da fonte dos campos de cadastro e checkout."
      }
    }
  },
  "size": {
    "mobile-screen": {
      "width": {
        "$type": "dimension",
        "$value": "270px",
        "$description": "Largura do mockup mobile original."
      },
      "height": {
        "$type": "dimension",
        "$value": "480px",
        "$description": "Altura do mockup mobile original."
      }
    },
    "button": {
      "height": {
        "$type": "dimension",
        "$value": "44px",
        "$description": "Altura declarada dos botões originais."
      },
      "width": {
        "$type": "dimension",
        "$value": "200px",
        "$description": "Largura do botão no cadastro/checkout; varia por projeto."
      },
      "hover-width": {
        "$type": "dimension",
        "$value": "220px",
        "$description": "Largura de hover declarada em cadastro/checkout."
      }
    },
    "input": {
      "width": {
        "$type": "dimension",
        "$value": "170px",
        "$description": "Largura declarada dos campos text/password."
      },
      "height-content": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "Altura declarada de conteúdo antes do padding vertical de 10px."
      }
    },
    "avatar": {
      "diameter": {
        "$type": "dimension",
        "$value": "90px",
        "$description": "Diâmetro de foto de perfil original."
      }
    }
  },
  "radius": {
    "pill": {
      "$type": "dimension",
      "$value": "50px",
      "$description": "Botões e campos arredondados."
    },
    "screen": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Cantos do viewport mobile original."
    },
    "switch": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "Raio do trilho do switch original."
    },
    "circle": {
      "$type": "dimension",
      "$value": "50%",
      "$description": "Avatares e botões de ação circulares."
    }
  },
  "shadow": {
    "screen": {
      "$type": "shadow",
      "$value": "10px 25px 60px 10px rgba(0,0,0,0.2)",
      "$description": "Sombra documentada no mockup mobile original."
    }
  },
  "motion": {
    "standard": {
      "$type": "duration",
      "$value": ".3s ease-in-out",
      "$description": "Transição recorrente de hover dos botões originais."
    }
  }
}